#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    TARGET="$(readlink "$SOURCE")"
    if [[ "$TARGET" != /* ]]; then
        SOURCE="$DIR/$TARGET"
    else
        SOURCE="$TARGET"
    fi
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="${MANTLE_REPO_ROOT:-${RTRACE_REPO_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}}"
VENV_PATH="${MANTLE_VENV:-${RTRACE_VENV:-$REPO_ROOT/.venv}}"

usage() {
    cat <<'EOF'
Usage:
    mantle serve [--host <host>] [--port <port>]
    mantle watch [--trace-id <id>] [--no-ebpf] <executable> [args...]
    mantle daemon start|stop|status

Commands:
    serve    Start the observability dashboard.
    watch    Run an executable under cgroup-isolated eBPF capture.
    daemon   Manage the eBPF tracing daemon (requires root).

Examples:
    mantle serve --host 0.0.0.0 --port 8099
    mantle watch aider
    mantle watch aider "inspect this repo and summarize"
    sudo mantle daemon start
EOF
}

compose_host_home() {
    if [[ -n "${MANTLE_HOST_HOME:-}" ]]; then
        echo "$MANTLE_HOST_HOME"
        return
    fi

    if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
        local sudo_home
        sudo_home="$(getent passwd "$SUDO_USER" | cut -d: -f6 || true)"
        if [[ -n "$sudo_home" ]]; then
            echo "$sudo_home"
            return
        fi
    fi

    echo "$HOME"
}

compose_cmd() {
    local mantle_host_home
    mantle_host_home="$(compose_host_home)"

    if ! docker info >/dev/null 2>&1; then
        echo "Error: cannot access Docker daemon." >&2
        echo "Run with sudo (for example: sudo $SCRIPT_DIR/mantle serve) or add this user to the docker group." >&2
        exit 1
    fi

    if docker compose version >/dev/null 2>&1; then
        MANTLE_HOST_HOME="$mantle_host_home" docker compose -f "$REPO_ROOT/docker-compose.yml" "$@"
        return
    fi

    if command -v docker-compose >/dev/null 2>&1; then
        MANTLE_HOST_HOME="$mantle_host_home" DOCKER_API_VERSION="${MANTLE_DOCKER_API_VERSION:-1.44}" \
            docker-compose -f "$REPO_ROOT/docker-compose.yml" "$@"
        return
    fi

    echo "Error: Docker Compose is required but not available." >&2
    echo "Install either the docker compose plugin or the docker-compose binary." >&2
    exit 1
}

# ── serve ─────────────────────────────────────────────────────────

serve_cmd() {
    local host port

    host="127.0.0.1"
    port="8099"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --host)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --host requires a value." >&2
                    exit 1
                fi
                host="$2"
                shift 2
                ;;
            --port)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --port requires a value." >&2
                    exit 1
                fi
                port="$2"
                shift 2
                ;;
            -h|--help|help)
                usage
                exit 0
                ;;
            *)
                echo "Unknown argument for 'serve': $1" >&2
                usage
                exit 1
                ;;
        esac
    done

    if [[ "$port" != "8099" ]]; then
        echo "Error: containerized serve currently supports only --port 8099." >&2
        exit 1
    fi

    if [[ "$host" != "127.0.0.1" ]] && [[ "$host" != "0.0.0.0" ]]; then
        echo "Error: containerized serve currently supports --host 127.0.0.1 or 0.0.0.0." >&2
        exit 1
    fi

    compose_cmd up -d server
}

# ── daemon ────────────────────────────────────────────────────────

daemon_cmd() {
    local action="${1:-}"

    case "$action" in
        start)
            compose_cmd up -d daemon
            ;;
        stop)
            compose_cmd exec -T daemon python3 -m mantle.daemon.client shutdown
            ;;
        status)
            compose_cmd exec -T daemon python3 -m mantle.daemon.client status
            ;;
        *)
            echo "Usage: mantle daemon start|stop|status" >&2
            exit 1
            ;;
    esac
}

# ── watch ─────────────────────────────────────────────────────────

watch_cmd() {
    local executable resolved_executable trace_id
    local logs_root obs_root config_root
    local -a task_args
    local enable_ebpf=true

    trace_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --trace-id)
                if [[ $# -lt 2 ]]; then
                    echo "Error: $1 requires a value." >&2
                    exit 1
                fi
                trace_id="$2"
                shift 2
                ;;
            --no-ebpf)
                enable_ebpf=false
                shift
                ;;
            -h|--help|help)
                usage
                exit 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                echo "Unknown argument for 'watch': $1" >&2
                usage
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    if [[ $# -lt 1 ]]; then
        echo "Error: 'watch' requires an executable (for example: aider)." >&2
        usage
        exit 1
    fi

    executable="$1"
    shift
    task_args=("$@")

    # Resolve executables without requiring shell PATH/venv activation.
    if [[ "$executable" == */* ]]; then
        resolved_executable="$executable"
    elif [[ -x "$VENV_PATH/bin/$executable" ]]; then
        resolved_executable="$VENV_PATH/bin/$executable"
    elif command -v "$executable" >/dev/null 2>&1; then
        resolved_executable="$(command -v "$executable")"
    else
        resolved_executable="$executable"
    fi

    # Setup directories and environment (production defaults to $HOME/.mantle)
    logs_root="${HOME}/.mantle/logs"
    obs_root="${HOME}/.mantle/obs"
    config_root="${HOME}/.mantle/config"

    export MANTLE_LOGS_DIR="$logs_root"
    export MANTLE_CONFIG_DIR="$config_root"
    export AGENT_OBS_ROOT="$obs_root"
    export OBS_TRACE_DIR="$obs_root/traces"
    export OBS_EVENTS_DIR="$obs_root/events"
    export MANTLE_PROXY_LOG_DIR="$obs_root/proxy"

    mkdir -p \
        "$obs_root/traces" \
        "$obs_root/events" \
        "$obs_root/mitm" \
        "$obs_root/proxy" \
        "$logs_root/runtime/bpf_collector" \
        "$logs_root/runtime/proxy" \
        "$logs_root/runtime/post_processing" \
        "$logs_root/runtime/server" \
        "$logs_root/runtime/frontend" \
        "$logs_root/runtime/agent" \
        "$config_root"

    # Generate trace ID
    local agent_tag
    agent_tag="$(basename "$resolved_executable")"
    [[ -z "$trace_id" ]] && trace_id="${agent_tag}_$(date +%Y%m%d_%H%M%S).ebpf.jsonl"
    local trace_basename="${trace_id%.ebpf.jsonl}"
    local output_file="$obs_root/traces/$trace_id"

    export AGENT_TRACE_ID="$trace_basename"

    local container_output_file="/app/.mantle/obs/traces/$trace_id"

    # No eBPF? Just run the agent directly.
    if ! $enable_ebpf; then
        echo "[*] Running $executable (eBPF disabled)..."
        "$resolved_executable" ${task_args[@]+"${task_args[@]}"}
        exit $?
    fi

    # ── Cgroup-based eBPF tracing ──────────────────────────────────
    #
    # If not yet inside a cgroup scope, re-exec ourselves inside one.
    # The _MANTLE_SCOPED guard prevents infinite re-exec.
    if [[ -z "${_MANTLE_SCOPED:-}" ]]; then
        export _MANTLE_SCOPED=1
        exec systemd-run --user --scope -q --unit="mantle-watch-$$" \
            "$SCRIPT_DIR/mantle" watch --trace-id "$trace_id" \
            "$resolved_executable" \
            ${task_args[@]+"${task_args[@]}"}
    fi

    # === We are now inside a cgroup scope ===

    local cgroup_path
    cgroup_path="/sys/fs/cgroup$(cut -d: -f3 /proc/self/cgroup)"

    local proxy_control_url="${MANTLE_PROXY_CONTROL_URL:-http://127.0.0.1:4000/mantle/active-trace}"

    # Ensure no inherited proxy vars accidentally reintroduce interception.
    unset HTTPS_PROXY HTTP_PROXY https_proxy http_proxy ALL_PROXY all_proxy 2>/dev/null || true

    echo "═══════════════════════════════════════════════════════════"
    echo "  Agent Trace (cgroup-isolated eBPF)"
    echo "═══════════════════════════════════════════════════════════"
    echo "  Agent:   $executable"
    echo "  Task:    ${task_args[*]:-<interactive>}"
    echo "  Trace:   $trace_id"
    echo "  Cgroup:  $cgroup_path"
    echo "  Output:  $output_file"
    echo "═══════════════════════════════════════════════════════════"

    # Tell daemon to start tracing this cgroup
    # Execute daemon client using pure Python standard library to hit the socket natively!
    # No docker dependency, no sudo dependency, no pip dependencies.
    if ! python3 -c '
import socket, json, sys
msg = {"cmd": "trace_start", "cgroup_path": sys.argv[1], "trace_id": sys.argv[2], "output_file": sys.argv[3], "agent_executable": sys.argv[4]}
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(3.0)
        s.connect("/var/run/mantle/mantle.sock")
        s.sendall((json.dumps(msg) + "\n").encode())
        resp = json.loads(s.recv(4096).decode())
        if resp.get("status") != "ok":
            print(resp.get("message", "Unknown error"), file=sys.stderr)
            sys.exit(1)
except Exception as e:
    print(str(e), file=sys.stderr)
    sys.exit(1)
' "$cgroup_path" "$trace_id" "$container_output_file" "$agent_tag"; then
        echo "Error: could not start eBPF trace." >&2
    echo "Hint: ensure services are running (for example: make build)." >&2
        exit 1
    fi

    # Notify proxy of active trace (best-effort)
    curl -sf -X POST -H "Content-Type: application/json" \
        -d "{\"trace_file\": \"$trace_id\"}" \
        "$proxy_control_url" >/dev/null 2>&1 || true

    # Export variables needed by the cleanup trap handler.
    _MANTLE_CLEANUP_TRACE_ID="$trace_id"
    _MANTLE_CLEANUP_PROXY_URL="$proxy_control_url"
    _MANTLE_CLEANUP_OUTPUT="$output_file"

    # Cleanup on exit (normal, SIGINT, SIGTERM)
    cleanup() {
        python3 -c '
import socket, json, sys
msg = {"cmd": "trace_stop", "trace_id": sys.argv[1]}
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(1.0)
        s.connect("/var/run/mantle/mantle.sock")
        s.sendall((json.dumps(msg) + "\n").encode())
except Exception:
    pass
' "$_MANTLE_CLEANUP_TRACE_ID" 2>/dev/null || true
        curl -sf -X POST -H "Content-Type: application/json" \
            -d '{"trace_file": null}' \
            "$_MANTLE_CLEANUP_PROXY_URL" >/dev/null 2>&1 || true
        echo ""
        echo "[*] Done. Captured data:"
        [[ -f "$_MANTLE_CLEANUP_OUTPUT" ]] && echo "    Trace: $_MANTLE_CLEANUP_OUTPUT ($(wc -l < "$_MANTLE_CLEANUP_OUTPUT") lines)"
        return 0
    }
    trap cleanup EXIT

    # Run the agent
    local agent_rc=0
    echo "[*] Running $executable..."
    "$resolved_executable" ${task_args[@]+"${task_args[@]}"} || agent_rc=$?
    return "$agent_rc"
}

# ── main dispatch ─────────────────────────────────────────────────

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

case "$1" in
    serve)
        shift
        serve_cmd "$@"
        ;;
    watch)
        shift
        watch_cmd "$@"
        ;;
    daemon)
        shift
        daemon_cmd "$@"
        ;;
    *)
        echo "Unknown command: $1" >&2
        usage
        exit 1
        ;;
esac
